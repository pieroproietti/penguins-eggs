{{ define "install_distro_initramfs" }}
mkdir -p /etc/initramfs-tools/conf.d
SWAP_UUID=$(awk '$3 == "swap" && $1 ~ /^UUID=/ {sub(/^UUID=/, "", $1); print $1}' /etc/fstab | head -n 1)
if [ -n "$SWAP_UUID" ]; then
    echo "RESUME=UUID=$SWAP_UUID" > /etc/initramfs-tools/conf.d/resume
else
    echo "RESUME=none" > /etc/initramfs-tools/conf.d/resume
fi
if [ -f /etc/initramfs-tools/initramfs.conf ]; then
    sed -i 's/^RESUME=.*/RESUME=none/' /etc/initramfs-tools/initramfs.conf
fi
if [ -x /usr/sbin/update-initramfs.orig.initramfs-tools ]; then
    /usr/sbin/update-initramfs.orig.initramfs-tools -u -k all
elif command -v update-initramfs >/dev/null 2>&1; then
    touch /.live-build
    update-initramfs -u -k all
    rm -f /.live-build
fi
{{ end }}

{{ define "install_distro_bootloader" }}
echo "-> Preserving original GRUB configuration & setting OS prober..."

if [ -f /etc/default/grub ]; then
    if grep -q "^GRUB_DISABLE_OS_PROBER=" /etc/default/grub; then
        sed -i 's/^GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
    else
        echo "GRUB_DISABLE_OS_PROBER=false" >> /etc/default/grub
    fi

    # Avoid 30-second delay if recordfail is triggered
    if grep -q "^GRUB_RECORDFAIL_TIMEOUT=" /etc/default/grub; then
        sed -i 's/^GRUB_RECORDFAIL_TIMEOUT=.*/GRUB_RECORDFAIL_TIMEOUT=0/' /etc/default/grub
    else
        echo "GRUB_RECORDFAIL_TIMEOUT=0" >> /etc/default/grub
    fi
fi

if [ -d /sys/firmware/efi ]; then
    ARCH=$(uname -m)
    case "$ARCH" in
        x86_64)
            GRUB_TARGET="x86_64-efi"
            GRUB_BIN="grubx64.efi"
            BOOT_BIN="BOOTX64.EFI"
            ;;
        aarch64|arm64)
            GRUB_TARGET="arm64-efi"
            GRUB_BIN="grubaa64.efi"
            BOOT_BIN="BOOTAA64.EFI"
            ;;
        riscv64)
            GRUB_TARGET="riscv64-efi"
            GRUB_BIN="grubriscv64.efi"
            BOOT_BIN="BOOTRISCV64.EFI"
            ;;
        i386|i686)
            GRUB_TARGET="i386-efi"
            GRUB_BIN="grubia32.efi"
            BOOT_BIN="BOOTIA32.EFI"
            ;;
        *)
            GRUB_TARGET="x86_64-efi"
            GRUB_BIN="grubx64.efi"
            BOOT_BIN="BOOTX64.EFI"
            ;;
    esac

    if ! grub-install --target="$GRUB_TARGET" --efi-directory=/boot/efi --bootloader-id={{ .DistroID }} --recheck; then
        [ -f "/boot/efi/EFI/{{ .DistroID }}/$GRUB_BIN" ] || { echo "[FATAL ERROR] grub-install failed and no EFI binary was written"; exit 1; }
    fi

    # Removable fallback
    mkdir -p /boot/efi/EFI/BOOT
    [ -f "/boot/efi/EFI/{{ .DistroID }}/$GRUB_BIN" ] && cp -f "/boot/efi/EFI/{{ .DistroID }}/$GRUB_BIN" "/boot/efi/EFI/BOOT/$BOOT_BIN"
    update-grub
elif [ "$(uname -m)" = "riscv64" ]; then
    echo "-> RISC-V platform detected: writing Spacemit K1 U-Boot bootloader..."
    SPACEMIT_ASSETS="/usr/share/penguins-eggs/spacemit"
    [ -d "$SPACEMIT_ASSETS" ] || SPACEMIT_ASSETS="/etc/penguins-eggs.d/spacemit"
    TARGET_DISK=$(grub-probe -t disk / 2>/dev/null || mount | grep " / " | awk '{print $1}' | sed 's/p[0-9]*$//')
    [ -z "$TARGET_DISK" ] && TARGET_DISK="/dev/nvme0n1"
    if [ -b "$TARGET_DISK" ]; then
        echo "Writing Spacemit K1 bootloader binaries to $TARGET_DISK..."
        [ -f "$SPACEMIT_ASSETS/factory/FSBL.bin" ] && dd if="$SPACEMIT_ASSETS/factory/FSBL.bin" of="${TARGET_DISK}p1" conv=fsync status=none 2>/dev/null || true
        [ -f "$SPACEMIT_ASSETS/fw_dynamic.itb" ] && dd if="$SPACEMIT_ASSETS/fw_dynamic.itb" of="${TARGET_DISK}p3" conv=fsync status=none 2>/dev/null || true
        [ -f "$SPACEMIT_ASSETS/u-boot.itb" ] && dd if="$SPACEMIT_ASSETS/u-boot.itb" of="${TARGET_DISK}p4" conv=fsync status=none 2>/dev/null || true
    fi
else
    TARGET_DISK=$(grub-probe -t disk / 2>/dev/null || echo "/dev/sda")
    grub-install --target=i386-pc --recheck "$TARGET_DISK"
    update-grub
fi
{{ end }}
