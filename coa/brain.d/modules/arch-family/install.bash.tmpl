# ==============================================================================
# 🏹 MASTER-MODULE ARCH FAMILY - INSTALL (Principle of Transparency)
# Includes: Arch Linux, Manjaro, Garuda, and derivatives (EndeavourOS, etc.)
# ==============================================================================

# ==============================================================================
# 🎯 FINAL DISK INSTALLER (Executed in Chroot)
# ==============================================================================
{{ define "install_distro_initramfs" }}
{{ if or (eq .DistroID "garuda") (eq .DistroID "endeavouros") }}
    echo "-> Regenerating initramfs on Garuda/EndeavourOS via dracut..."
    
    KVER_DIR=$(uname -r)
    if [ ! -d "/lib/modules/$KVER_DIR" ]; then
        # Fall back if uname -r doesn't match an installed kernel (e.g. an
        # unrebooted upgrade) - matches whichever kernel is actually present.
        KVER_DIR=$(ls -1 /lib/modules/ | grep -v "extramodules" | head -n 1)
    fi
    if [ -z "$KVER_DIR" ]; then
        echo "[FATAL ERROR] Unable to determine the kernel in the chroot."
        exit 1
    fi

    INITRD_TARGET="/boot/initramfs-$KVER_DIR.img"

    # Clear stale initramfs-*.img so the bootloader steps' unordered
    # `find | head -n1` can't pick a non-btrfs leftover instead of ours.
    find /boot -maxdepth 1 -name "initramfs-*.img" ! -name "*fallback*" ! -name "$(basename "$INITRD_TARGET")" -delete

    # -N (no-hostonly) is vital to generate the image correctly from within the chroot
    # Explicit outfile: Garuda's dracut.conf.d defaults to a BLS path that doesn't exist yet.
    if ! dracut -N -f --add "btrfs" --kver "$KVER_DIR" "$INITRD_TARGET"; then
        echo "[FATAL ERROR] dracut failed to generate $INITRD_TARGET"
        exit 1
    fi
    if [ ! -f "$INITRD_TARGET" ]; then
        echo "[FATAL ERROR] dracut reported success but $INITRD_TARGET is missing"
        exit 1
    fi

{{ else }}
    echo "-> Regenerating mkinitcpio-based initramfs..."
    # Ensure Limine ESP_PATH is configured before mkinitcpio triggers limine hooks
    ESP_MOUNT=""
    if mountpoint -q /boot/efi 2>/dev/null || awk '$2 == "/boot/efi" {exit 0} END {exit 1}' /etc/fstab 2>/dev/null; then
        ESP_MOUNT="/boot/efi"
    elif mountpoint -q /efi 2>/dev/null || awk '$2 == "/efi" {exit 0} END {exit 1}' /etc/fstab 2>/dev/null; then
        ESP_MOUNT="/efi"
    elif mountpoint -q /boot 2>/dev/null || awk '$2 == "/boot" {exit 0} END {exit 1}' /etc/fstab 2>/dev/null; then
        ESP_MOUNT="/boot"
    else
        ESP_MOUNT="/boot/efi"
    fi
    for CONF_FILE in /etc/limine-entry-tool.conf /etc/default/limine; do
        if [ -f "$CONF_FILE" ]; then
            if grep -q "^ESP_PATH=" "$CONF_FILE"; then
                sed -i "s|^ESP_PATH=.*|ESP_PATH=\"$ESP_MOUNT\"|" "$CONF_FILE"
            elif grep -q "^#ESP_PATH=" "$CONF_FILE"; then
                sed -i "s|^#ESP_PATH=.*|ESP_PATH=\"$ESP_MOUNT\"|" "$CONF_FILE"
            else
                echo "ESP_PATH=\"$ESP_MOUNT\"" >> "$CONF_FILE"
            fi
        fi
    done

    ROOT_PART_INIT=$(awk '$2 == "/" && $1 !~ /^#/ {print $1}' /etc/fstab)
    if [ -n "$ROOT_PART_INIT" ]; then
        for CONF_FILE in /etc/limine-entry-tool.conf /etc/default/limine /etc/kernel/cmdline; do
            if [ -f "$CONF_FILE" ]; then
                sed -i "s|root=UUID=[^ \"']*|root=$ROOT_PART_INIT|g" "$CONF_FILE"
                sed -i "s|root=/dev/[^ \"']*|root=$ROOT_PART_INIT|g" "$CONF_FILE"
            fi
        done
    fi

    ROOT_FSTYPE=$(awk '$2 == "/" {print $3}' /etc/fstab)
    if [ "$ROOT_FSTYPE" = "btrfs" ]; then
        if ! grep -q "^HOOKS=.*btrfs" /etc/mkinitcpio.conf; then
            sed -i '/^HOOKS=/ s/\bfilesystems\b/btrfs filesystems/' /etc/mkinitcpio.conf
        fi
    fi
    mkinitcpio -P
{{ end }}
{{ end }}

# ==============================================================================
# 🎯 BOOTLOADER DISPATCHER (Principle of Transparency: Evidence-Based Detection)
# ==============================================================================
{{ define "install_distro_bootloader" }}
echo "-> Evidence-based bootloader detection and dispatch..."

if [ -d /sys/firmware/efi ]; then
    echo "-> UEFI environment detected."
    # 1. Configs over Binaries
    if [ -f /boot/limine.conf ] || [ -f /boot/efi/limine.conf ] || [ -f /boot/limine/limine.conf ] || [ -f /boot/efi/limine/limine.conf ] || [ -f /etc/limine-entry-tool.conf ] || [ -f /etc/default/limine ]; then
        echo "-> Evidence found: Limine configuration detected."
        {{ include "install_distro_limine" . }}
    elif [ -f /boot/loader/loader.conf ] || [ -f /boot/efi/loader/loader.conf ]; then
        echo "-> Evidence found: systemd-boot configuration detected."
        {{ include "install_distro_systemd_boot" . }}
    elif [ -f /etc/default/grub ] || [ -f /boot/grub/grub.cfg ]; then
        echo "-> Evidence found: GRUB configuration detected."
        {{ include "install_distro_grub" . }}
    elif command -v bootctl &> /dev/null; then
        {{ include "install_distro_systemd_boot" . }}
    elif command -v limine &> /dev/null; then
        {{ include "install_distro_limine" . }}
    else
        {{ include "install_distro_grub" . }}
    fi
else
    echo "-> BIOS/Legacy environment detected."
    if [ -f /boot/limine.conf ] || [ -f /boot/limine/limine.conf ] || [ -f /etc/limine-entry-tool.conf ] || [ -f /etc/default/limine ]; then
        echo "-> Evidence found: Limine configuration detected."
        {{ include "install_distro_limine" . }}
    else
        {{ include "install_distro_grub" . }}
    fi
fi
{{ end }}

{{ define "install_distro_grub" }}
echo "-> Installing GRUB (Preserving Original DNA)..."

if ! command -v grub-install &> /dev/null; then
    echo "-> grub package is missing. Installing it on the fly..."
    pacman -Sy --noconfirm grub || { echo "[WARNING] Failed to install grub"; }
fi

if [ -f /etc/default/grub ]; then
    if grep -q "^GRUB_DISABLE_OS_PROBER=" /etc/default/grub; then
        sed -i 's/^GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
    else
        echo "GRUB_DISABLE_OS_PROBER=false" >> /etc/default/grub
    fi
fi

if [ -d /sys/firmware/efi ] && grep -q "/boot/efi" /proc/mounts; then
    echo "-> UEFI installation..."
    if ! grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id={{ .DistroID }} --recheck; then
        # NVRAM-registration can fail (e.g. OVMF/VM firmware) even though the
        # EFI binary was written correctly; only abort if it genuinely wasn't.
        [ -f "/boot/efi/EFI/{{ .DistroID }}/grubx64.efi" ] || { echo "[FATAL ERROR] grub-install failed and no EFI binary was written"; exit 1; }
        echo "-> WARNING: grub-install failed (likely NVRAM-only); EFI binary is present, continuing with removable fallback."
    fi

    mkdir -p /boot/efi/EFI/BOOT
    [ -f "/boot/efi/EFI/{{ .DistroID }}/grubx64.efi" ] && cp -f "/boot/efi/EFI/{{ .DistroID }}/grubx64.efi" /boot/efi/EFI/BOOT/BOOTX64.EFI
else
    echo "-> BIOS/Legacy installation..."
    ROOT_PART_FSTAB=$(awk '$2 == "/" {print $1}' /etc/fstab)
    if [[ "$ROOT_PART_FSTAB" == UUID=* ]] || [[ "$ROOT_PART_FSTAB" == LABEL=* ]]; then
        ROOT_DEV=$(findfs "$ROOT_PART_FSTAB" 2>/dev/null || echo "/dev/sda1")
    else
        ROOT_DEV=${ROOT_PART_FSTAB:-"/dev/sda1"}
    fi
    
    if [[ "$ROOT_DEV" == *nvme* ]] || [[ "$ROOT_DEV" == *mmcblk* ]] || [[ "$ROOT_DEV" == *loop* ]]; then
        TARGET_DISK=$(echo "$ROOT_DEV" | sed -E 's/p[0-9]+$//')
    else
        TARGET_DISK=$(echo "$ROOT_DEV" | sed -E 's/[0-9]+$//')
    fi
    [ -z "$TARGET_DISK" ] && TARGET_DISK="/dev/sda"
    
    echo "-> Target disk: $TARGET_DISK"
    grub-install --target=i386-pc --recheck "$TARGET_DISK"
fi

ROOT_FSTYPE=$(awk '$2 == "/" {print $3}' /etc/fstab)
if [ "$ROOT_FSTYPE" = "btrfs" ]; then
    echo "-> Btrfs configuration detected. Creating /boot symlink at the root level..."
    ROOT_PART_FSTAB=$(awk '$2 == "/" {print $1}' /etc/fstab)
    if [[ "$ROOT_PART_FSTAB" == UUID=* ]] || [[ "$ROOT_PART_FSTAB" == LABEL=* ]]; then
        ROOT_DEV=$(findfs "$ROOT_PART_FSTAB")
    else
        ROOT_DEV=$ROOT_PART_FSTAB
    fi
    mkdir -p /tmp/btrfs-raw
    mount "$ROOT_DEV" /tmp/btrfs-raw
    ln -sf @/boot /tmp/btrfs-raw/boot
    umount /tmp/btrfs-raw
    rmdir /tmp/btrfs-raw
fi

# =====================================================================
# FIX PER GRUB SU ENDEAVOUROS / SYSTEMD-BOOT LAYOUT
# Controlliamo se c'è un kernel in /boot. Se manca, lo peschiamo dai moduli.
# =====================================================================
if ! ls /boot/vmlinuz-* 1> /dev/null 2>&1; then
    echo "-> Nessun kernel trovato in /boot. Cerco nei moduli (layout systemd-boot)..."
    KERNEL_PATH="/usr/lib/modules/$(uname -r)/vmlinuz"
    [ -f "$KERNEL_PATH" ] || KERNEL_PATH=$(find /usr/lib/modules -name "vmlinuz" -type f | head -n 1)

    if [ -n "$KERNEL_PATH" ]; then
        # Recupera il nome della versione (es. 6.1.12-arch1-1)
        KVER=$(basename $(dirname "$KERNEL_PATH"))
        echo "-> Copio il kernel in /boot/vmlinuz-$KVER per GRUB..."
        cp "$KERNEL_PATH" "/boot/vmlinuz-$KVER"
    else
        echo "[WARNING] Nessun kernel trovato da copiare in /boot per GRUB. La configurazione potrebbe fallire."
    fi
fi

# Ora GRUB troverà sicuramente il kernel in /boot!
grub-mkconfig -o /boot/grub/grub.cfg
{{ end }}

{{ define "install_distro_systemd_boot" }}
echo "-> Installing systemd-boot (bootctl)..."

ESP_MOUNT=""
if mountpoint -q /boot/efi 2>/dev/null || awk '$2 == "/boot/efi" {exit 0} END {exit 1}' /etc/fstab 2>/dev/null; then
    ESP_MOUNT="/boot/efi"
elif mountpoint -q /efi 2>/dev/null || awk '$2 == "/efi" {exit 0} END {exit 1}' /etc/fstab 2>/dev/null; then
    ESP_MOUNT="/efi"
elif mountpoint -q /boot 2>/dev/null || awk '$2 == "/boot" {exit 0} END {exit 1}' /etc/fstab 2>/dev/null; then
    ESP_MOUNT="/boot"
else
    ESP_MOUNT="/boot/efi"
fi

echo "-> Target ESP mount point: $ESP_MOUNT"
mkdir -p "$ESP_MOUNT"
if ! mountpoint -q "$ESP_MOUNT" 2>/dev/null; then
    echo "-> Mounting $ESP_MOUNT..."
    mount "$ESP_MOUNT" || true
fi

bootctl install --esp-path="$ESP_MOUNT"
mkdir -p "$ESP_MOUNT/loader/entries"

ROOT_PART=$(awk '$2 == "/" && $1 !~ /^#/ {print $1}' /etc/fstab)
if [ -z "$ROOT_PART" ]; then
    ROOT_PART=$(df / | awk 'NR==2 {print $1}')
fi
ROOT_FSTYPE=$(awk '$2 == "/" {print $3}' /etc/fstab)
ROOTFLAGS=""
if [ "$ROOT_FSTYPE" = "btrfs" ]; then
    ROOTFLAGS="rootflags=subvol=@"
fi

PRETTY_NAME=$(grep ^PRETTY_NAME= /etc/os-release | cut -d= -f2 | tr -d '"')
if [ -z "$PRETTY_NAME" ]; then
    PRETTY_NAME="Arch Linux"
fi

UCODE_LINE=""
if [ -f /boot/amd-ucode.img ]; then
    [ "$ESP_MOUNT" != "/boot" ] && cp -L /boot/amd-ucode.img "$ESP_MOUNT/"
    UCODE_LINE="initrd  /amd-ucode.img"
elif [ -f /boot/intel-ucode.img ]; then
    [ "$ESP_MOUNT" != "/boot" ] && cp -L /boot/intel-ucode.img "$ESP_MOUNT/"
    UCODE_LINE="initrd  /intel-ucode.img"
fi

DEFAULT_ENTRY=""
for KERNEL_PATH in $(find /boot -maxdepth 1 -name "vmlinuz-*" -type f); do
    KERNEL_FILE=$(basename "$KERNEL_PATH")
    INITRD_FILE="initramfs-${KERNEL_FILE#vmlinuz-}.img"
    INITRD_PATH="/boot/$INITRD_FILE"
    if [ ! -f "$INITRD_PATH" ]; then
        INITRD_PATH=$(find /boot -maxdepth 1 -name "initramfs-*.img" ! -name "*fallback*" -type f | head -n 1)
        [ -n "$INITRD_PATH" ] && INITRD_FILE=$(basename "$INITRD_PATH")
    fi

    if [ "$ESP_MOUNT" != "/boot" ]; then
        echo "-> Copying kernel ($KERNEL_PATH) to $ESP_MOUNT/$KERNEL_FILE..."
        cp -L "$KERNEL_PATH" "$ESP_MOUNT/$KERNEL_FILE" || true
        if [ -f "$INITRD_PATH" ]; then
            echo "-> Copying initrd ($INITRD_PATH) to $ESP_MOUNT/$INITRD_FILE..."
            cp -L "$INITRD_PATH" "$ESP_MOUNT/$INITRD_FILE" || true
        fi
    fi

    ENTRY_ID="{{ .DistroID }}-${KERNEL_FILE#vmlinuz-}.conf"
    [ -z "$DEFAULT_ENTRY" ] && DEFAULT_ENTRY="$ENTRY_ID"

cat <<EOF > "$ESP_MOUNT/loader/entries/$ENTRY_ID"
title   $PRETTY_NAME (${KERNEL_FILE#vmlinuz-})
linux   /$KERNEL_FILE
${UCODE_LINE}
initrd  /$INITRD_FILE
options root=$ROOT_PART rw $ROOTFLAGS
EOF
done

if [ ! -f "$ESP_MOUNT/loader/loader.conf" ]; then
cat <<EOF > "$ESP_MOUNT/loader/loader.conf"
default $DEFAULT_ENTRY
timeout 5
console-mode max
editor yes
EOF
fi
{{ end }}

{{ define "install_distro_limine" }}
echo "-> Installing Limine bootloader..."

ESP_MOUNT=""
if mountpoint -q /boot/efi 2>/dev/null || awk '$2 == "/boot/efi" {exit 0} END {exit 1}' /etc/fstab 2>/dev/null; then
    ESP_MOUNT="/boot/efi"
elif mountpoint -q /efi 2>/dev/null || awk '$2 == "/efi" {exit 0} END {exit 1}' /etc/fstab 2>/dev/null; then
    ESP_MOUNT="/efi"
elif mountpoint -q /boot 2>/dev/null || awk '$2 == "/boot" {exit 0} END {exit 1}' /etc/fstab 2>/dev/null; then
    ESP_MOUNT="/boot"
else
    ESP_MOUNT="/boot/efi"
fi

echo "-> Target ESP mount point: $ESP_MOUNT"
mkdir -p "$ESP_MOUNT"
if ! mountpoint -q "$ESP_MOUNT" 2>/dev/null; then
    echo "-> Mounting $ESP_MOUNT..."
    mount "$ESP_MOUNT" || true
fi

# Configure ESP_PATH and target root UUID in Limine configs so native limine-update/limine-mkinitcpio won't fail or use host UUID
for CONF_FILE in /etc/limine-entry-tool.conf /etc/default/limine; do
    if [ -f "$CONF_FILE" ]; then
        echo "-> Setting ESP_PATH=\"$ESP_MOUNT\" in $CONF_FILE..."
        if grep -q "^ESP_PATH=" "$CONF_FILE"; then
            sed -i "s|^ESP_PATH=.*|ESP_PATH=\"$ESP_MOUNT\"|" "$CONF_FILE"
        elif grep -q "^#ESP_PATH=" "$CONF_FILE"; then
            sed -i "s|^#ESP_PATH=.*|ESP_PATH=\"$ESP_MOUNT\"|" "$CONF_FILE"
        else
            echo "ESP_PATH=\"$ESP_MOUNT\"" >> "$CONF_FILE"
        fi
    fi
done

ROOT_PART_TARGET=$(awk '$2 == "/" && $1 !~ /^#/ {print $1}' /etc/fstab)
if [ -n "$ROOT_PART_TARGET" ]; then
    for CONF_FILE in /etc/limine-entry-tool.conf /etc/default/limine /etc/kernel/cmdline; do
        if [ -f "$CONF_FILE" ]; then
            echo "-> Updating root partition in $CONF_FILE to $ROOT_PART_TARGET..."
            sed -i "s|root=UUID=[^ \"']*|root=$ROOT_PART_TARGET|g" "$CONF_FILE"
            sed -i "s|root=/dev/[^ \"']*|root=$ROOT_PART_TARGET|g" "$CONF_FILE"
        fi
    done
fi

if [ -d /sys/firmware/efi ]; then
    mkdir -p "$ESP_MOUNT/EFI/BOOT"
    if [ -f /usr/share/limine/BOOTX64.EFI ]; then
        cp -f /usr/share/limine/BOOTX64.EFI "$ESP_MOUNT/EFI/BOOT/"
    fi
else
    ROOT_PART_FSTAB=$(awk '$2 == "/" {print $1}' /etc/fstab)
    if [[ "$ROOT_PART_FSTAB" == UUID=* ]] || [[ "$ROOT_PART_FSTAB" == LABEL=* ]]; then
        ROOT_DEV=$(findfs "$ROOT_PART_FSTAB" 2>/dev/null || echo "/dev/sda1")
    else
        ROOT_DEV=${ROOT_PART_FSTAB:-"/dev/sda1"}
    fi
    
    if [[ "$ROOT_DEV" == *nvme* ]] || [[ "$ROOT_DEV" == *mmcblk* ]] || [[ "$ROOT_DEV" == *loop* ]]; then
        TARGET_DISK=$(echo "$ROOT_DEV" | sed -E 's/p[0-9]+$//')
    else
        TARGET_DISK=$(echo "$ROOT_DEV" | sed -E 's/[0-9]+$//')
    fi
    [ -z "$TARGET_DISK" ] && TARGET_DISK="/dev/sda"
    
    echo "-> Target disk for Limine BIOS install: $TARGET_DISK"
    limine bios-install "$TARGET_DISK" || true
fi

UCODE_LINE=""
if [ -f /boot/amd-ucode.img ]; then
    [ "$ESP_MOUNT" != "/boot" ] && cp -L /boot/amd-ucode.img "$ESP_MOUNT/"
    UCODE_LINE="    module_path: boot:///amd-ucode.img"
elif [ -f /boot/intel-ucode.img ]; then
    [ "$ESP_MOUNT" != "/boot" ] && cp -L /boot/intel-ucode.img "$ESP_MOUNT/"
    UCODE_LINE="    module_path: boot:///intel-ucode.img"
fi

ROOT_PART=$(awk '$2 == "/" && $1 !~ /^#/ {print $1}' /etc/fstab)
if [ -z "$ROOT_PART" ]; then
    ROOT_PART=$(df / | awk 'NR==2 {print $1}')
fi
ROOT_FSTYPE=$(awk '$2 == "/" {print $3}' /etc/fstab)
ROOTFLAGS=""
if [ "$ROOT_FSTYPE" = "btrfs" ]; then
    ROOTFLAGS="rootflags=subvol=@"
fi

PRETTY_NAME=$(grep ^PRETTY_NAME= /etc/os-release | cut -d= -f2 | tr -d '"')
if [ -z "$PRETTY_NAME" ]; then
    PRETTY_NAME="Arch Linux"
fi

LIMINE_CONF="$ESP_MOUNT/limine.conf"
cat <<EOF > "$LIMINE_CONF"
timeout: 5
EOF

# Process all installed kernels found in /boot
for KERNEL_PATH in $(find /boot -maxdepth 1 -name "vmlinuz-*" -type f); do
    KERNEL_FILE=$(basename "$KERNEL_PATH")
    INITRD_FILE="initramfs-${KERNEL_FILE#vmlinuz-}.img"
    INITRD_PATH="/boot/$INITRD_FILE"
    if [ ! -f "$INITRD_PATH" ]; then
        INITRD_PATH=$(find /boot -maxdepth 1 -name "initramfs-*.img" ! -name "*fallback*" -type f | head -n 1)
        [ -n "$INITRD_PATH" ] && INITRD_FILE=$(basename "$INITRD_PATH")
    fi

    if [ "$ESP_MOUNT" != "/boot" ]; then
        echo "-> Copying kernel ($KERNEL_PATH) to $ESP_MOUNT/$KERNEL_FILE..."
        cp -L "$KERNEL_PATH" "$ESP_MOUNT/$KERNEL_FILE" || true
        if [ -f "$INITRD_PATH" ]; then
            echo "-> Copying initrd ($INITRD_PATH) to $ESP_MOUNT/$INITRD_FILE..."
            cp -L "$INITRD_PATH" "$ESP_MOUNT/$INITRD_FILE" || true
        fi
    fi

    ENTRY_NAME="$PRETTY_NAME (${KERNEL_FILE#vmlinuz-})"
cat <<EOF >> "$LIMINE_CONF"

/: $ENTRY_NAME
    protocol: linux
    kernel_path: boot:///$KERNEL_FILE
${UCODE_LINE}
    module_path: boot:///$INITRD_FILE
    cmdline: root=$ROOT_PART rw $ROOTFLAGS
EOF
done

if [ -d "$ESP_MOUNT/EFI/BOOT" ]; then
    cp -f "$LIMINE_CONF" "$ESP_MOUNT/EFI/BOOT/limine.conf"
fi
if [ "$ESP_MOUNT" != "/boot" ]; then
    mkdir -p /boot/limine 2>/dev/null || true
    cp -f "$LIMINE_CONF" /boot/limine.conf 2>/dev/null || true
fi

if command -v limine-update &> /dev/null; then
    echo "-> Executing native limine-update..."
    rm -f "$ESP_MOUNT/EFI/BOOT/limine.conf" "$ESP_MOUNT/EFI/limine/limine.conf" 2>/dev/null || true
    limine-update || true
    if [ -f "$ESP_MOUNT/limine.conf" ]; then
        echo "-> Syncing limine.conf to EFI boot directories..."
        [ -d "$ESP_MOUNT/EFI/BOOT" ] && cp -f "$ESP_MOUNT/limine.conf" "$ESP_MOUNT/EFI/BOOT/limine.conf"
        [ -d "$ESP_MOUNT/EFI/limine" ] && cp -f "$ESP_MOUNT/limine.conf" "$ESP_MOUNT/EFI/limine/limine.conf"
    fi
fi
{{ end }}
